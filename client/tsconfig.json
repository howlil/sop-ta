{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/api/auth": ["./src/features/auth/api.ts"],
      "@/api/evaluasi": ["./src/features/evaluation/index.ts"],
      "@/api/evaluator-anggota": ["./src/features/organization/api/evaluator-anggota.ts"],
      "@/api/kepala-opd": ["./src/features/organization/api/kepala-opd.ts"],
      "@/api/notifications": ["./src/features/notifications/api.ts"],
      "@/api/opd": ["./src/features/organization/api/opd.ts"],
      "@/api/penyusun": ["./src/features/organization/api/penyusun.ts"],
      "@/api/peraturan": ["./src/features/regulations/api.ts"],
      "@/api/sop": ["./src/features/sop/index.ts"],
      "@/api/sop-client": ["./src/features/sop/api/client.ts"],
      "@/api/sop-mutations": ["./src/features/sop/api/mutations.ts"],
      "@/api/sop-public": ["./src/features/sop/api/public.ts"],
      "@/api/sop-queries": ["./src/features/sop/api/queries.ts"],
      "@/api/tte": ["./src/features/tte/api.ts"],

      "@/components/data/*": ["./src/shared/data/*"],
      "@/components/evaluasi/*": ["./src/features/evaluation/ui/*"],
      "@/components/forms/*": ["./src/shared/forms/ui/*"],
      "@/components/layout/*": ["./src/app/layout/*"],
      "@/components/organisasi/*": ["./src/features/organization/ui/*"],
      "@/components/pengajuan/*": ["./src/features/submission/ui/*"],
      "@/components/person/*": ["./src/shared/person/*"],
      "@/components/security/*": ["./src/features/auth/ui/*"],
      "@/components/sop/sop-diagram": ["./src/features/sop/ui/sop-diagram/index.ts"],
      "@/components/sop/sop-diagram/*": ["./src/features/sop/diagram/*"],
      "@/components/sop/*": ["./src/features/sop/ui/*"],
      "@/components/status/*": ["./src/shared/status/ui/*"],
      "@/components/tte/*": ["./src/features/tte/ui/*"],
      "@/components/ui/*": ["./src/shared/ui/*"],

      "@/hooks/use-app-role": ["./src/features/auth/hooks/use-app-role.ts"],
      "@/hooks/use-debounced-value": ["./src/shared/hooks/use-debounced-value.ts"],
      "@/hooks/use-document-title": ["./src/shared/hooks/use-document-title.ts"],
      "@/hooks/use-in-app-notifications": ["./src/features/notifications/hooks/use-in-app-notifications.ts"],
      "@/hooks/use-mutation-with-toast": ["./src/shared/hooks/use-mutation-with-toast.ts"],
      "@/hooks/use-require-tte-setup": ["./src/features/tte/hooks/use-require-tte-setup.ts"],
      "@/hooks/use-sop-preview-diagram-state": ["./src/features/sop/hooks/use-sop-preview-diagram-state.ts"],
      "@/hooks/use-toast": ["./src/shared/hooks/use-toast.ts"],
      "@/hooks/useAppRole": ["./src/features/auth/hooks/use-app-role.ts"],
      "@/hooks/useMutationWithToast": ["./src/shared/hooks/use-mutation-with-toast.ts"],
      "@/hooks/useToast": ["./src/shared/hooks/use-toast.ts"],

      "@/lib/api/*": ["./src/shared/api/*"],
      "@/lib/evaluasi/hooks/*": ["./src/features/evaluation/hooks/*"],
      "@/lib/evaluasi/*": ["./src/features/evaluation/model/*"],
      "@/lib/forms/*": ["./src/shared/forms/model/*"],
      "@/lib/hydration/*": ["./src/shared/hydration/*"],
      "@/lib/notifications/*": ["./src/features/notifications/model/*"],
      "@/lib/pengajuan/*": ["./src/features/submission/model/*"],
      "@/lib/print/*": ["./src/shared/print/*"],
      "@/lib/sop/*": ["./src/features/sop/model/*"],
      "@/lib/status/*": ["./src/shared/status/model/*"],
      "@/lib/tte/*": ["./src/features/tte/model/*"],

      "@/utils/*": ["./src/shared/lib/*"],
      "@/config/*": ["./src/app/config/*"],
      "@/stores/*": ["./src/app/stores/*"],
      "@/*": ["./src/*"]
    }
  }
}
